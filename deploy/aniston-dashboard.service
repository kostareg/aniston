[Unit]
Description=Aniston: Streamlit dashboard on port 1313
After=network-online.target

[Service]
WorkingDirectory=%h/Projects/aniston
# Localhost only: the dashboard has no login and shows your trade targets. Put Cloudflare Tunnel + Access
# (or a reverse proxy with auth) in front, or set 0.0.0.0 to expose it directly on the network.
Environment=STREAMLIT_SERVER_ADDRESS=127.0.0.1
Environment=STREAMLIT_SERVER_PORT=1313
Environment=STREAMLIT_SERVER_HEADLESS=true
Environment=STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
ExecStart=/run/current-system/sw/bin/nix develop %h/Projects/aniston -c uv run streamlit run app/Home.py
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
